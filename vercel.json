{
  "version": 2,
  "builds": [
    { "src": "api/ai.js", "use": "@vercel/node" },
    { "src": "server.mjs", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/ai", "dest": "/api/ai.js" },
    { "src": "/api/ai.js", "dest": "/api/ai.js" },
    { "src": "/(.*)", "dest": "/server.mjs" }
  ],
  "functions": {
    "api/ai.js": { "maxDuration": 30 },
    "server.mjs": { "maxDuration": 60 }
  }
}