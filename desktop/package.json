{
  "name": "lolite-desktop",
  "productName": "Lolite OS",
  "version": "3.15.2",
  "private": true,
  "description": "Lolite OS for Windows with Lolite Launcher",
  "author": "Lolite OS",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "start": "npm run prepare:app && electron . --launcher",
    "start:os": "npm run prepare:app && electron . --os",
    "test": "node --test test/*.test.cjs",
    "build:win": "npm run prepare:app && electron-builder --win nsis --x64 --publish never && node scripts/release.mjs",
    "pack:win": "npm run prepare:app && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": { "semver": "7.7.4" },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "@resvg/resvg-js": "2.6.2",
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@supabase/supabase-js": "2.76.1",
    "@mlc-ai/web-llm": "0.2.79",
    "esbuild": "0.25.12",
    "highlight.js": "11.11.1",
    "marked": "15.0.7",
    "heic2any": "0.0.4",
    "pako": "1.0.11",
    "utif": "3.1.0",
    "pdfjs-dist": "4.10.38",
    "three": "0.169.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
